#!/bin/bash
# =============================================================
#  双击本文件 = 把工具共享给同事（内网访问）
#  运行后会打开一个终端窗口并打印访问网址，把网址发到工作群即可。
#  关闭该终端窗口 = 停止共享。
# =============================================================
cd "$(dirname "$0")" || exit 1
chmod +x ./serve.sh 2>/dev/null
exec ./serve.sh "${1:-8899}"
